<Window
    x:Class="Vers.Gui.MainWindow"
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Width="1120"
    Height="760"
    Icon="avares://ver/Assets/AppIcon.ico"
    MinWidth="900"
    MinHeight="620"
    WindowStartupLocation="CenterScreen">
  <Window.Resources>
    <StreamGeometry x:Key="EditIconGeometry">M3,17.25 V21 H6.75 L17.81,9.94 14.06,6.19 3,17.25 M20.71,7.04 C21.1,6.65 21.1,6 20.71,5.63 L18.37,3.29 C18,2.9 17.35,2.9 16.96,3.29 L15.12,5.12 18.87,8.87 20.71,7.04 Z</StreamGeometry>
    <StreamGeometry x:Key="DeleteIconGeometry">M6,19 C6,20.1 6.9,21 8,21 H16 C17.1,21 18,20.1 18,19 V7 H6 V19 M8,9 H16 V19 H8 V9 M15.5,4 L14.5,3 H9.5 L8.5,4 H5 V6 H19 V4 H15.5 Z</StreamGeometry>
  </Window.Resources>
  <Window.Styles>
    <Style Selector="Button.icon-action">
      <Setter Property="Width" Value="26" />
      <Setter Property="Height" Value="26" />
      <Setter Property="Padding" Value="5" />
      <Setter Property="MinWidth" Value="26" />
      <Setter Property="MinHeight" Value="26" />
    </Style>
  </Window.Styles>
  <Grid RowDefinitions="Auto,*,Auto">
    <Border Grid.Row="0" Padding="20,12" BorderBrush="{DynamicResource SemiColorBorder}" BorderThickness="0,0,0,1">
      <Grid ColumnDefinitions="*,Auto" VerticalAlignment="Center">
        <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
          <TextBlock x:Name="LanguageLabel" VerticalAlignment="Center" />
          <ComboBox x:Name="LanguageCombo" Width="130" Height="36" VerticalAlignment="Center" DisplayMemberBinding="{Binding DisplayName}" SelectionChanged="OnLanguageChanged" />
          <Button x:Name="ConfigurePathButton" Width="112" Height="36" Margin="4,0,0,0" Padding="10,0" VerticalAlignment="Center" VerticalContentAlignment="Center" Click="OnConfigurePathClick" />
        </StackPanel>
      </Grid>
    </Border>

    <Grid Grid.Row="1" ColumnDefinitions="250,*">
      <Border Padding="14" BorderBrush="{DynamicResource SemiColorBorder}" BorderThickness="0,0,1,0">
        <Grid RowDefinitions="Auto,*,Auto">
          <TextBlock x:Name="GroupsLabel" FontSize="15" FontWeight="SemiBold" Margin="6,2,0,10" />
          <ListBox x:Name="GroupList" Grid.Row="1" SelectionChanged="OnGroupSelectionChanged">
            <ListBox.ItemTemplate>
              <DataTemplate>
                <Grid Width="190" Height="30" ColumnDefinitions="*,Auto,Auto" Margin="2,0" ToolTip.Tip="{Binding WarningText}">
                  <TextBlock Text="{Binding Name}" VerticalAlignment="Center" />
                  <Grid Grid.Column="1" IsVisible="{Binding HasWarning}">
                    <TextBlock Classes="row-warning" Text="[WARN]" Margin="10,0,0,0" VerticalAlignment="Center" FontSize="11" FontWeight="SemiBold" Foreground="#D99A2B" IsVisible="{Binding !$parent[ListBoxItem].IsPointerOver}" />
                  </Grid>
                  <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="4" IsVisible="{Binding $parent[ListBoxItem].IsPointerOver}">
                    <Button Classes="icon-action" CommandParameter="{Binding Name}" ToolTip.Tip="{Binding EditText}" Click="OnEditGroupItemClick">
                      <PathIcon Data="{StaticResource EditIconGeometry}" />
                    </Button>
                    <Button Classes="icon-action" CommandParameter="{Binding Name}" ToolTip.Tip="{Binding DeleteText}" Click="OnDeleteGroupItemClick">
                      <PathIcon Data="{StaticResource DeleteIconGeometry}" />
                    </Button>
                  </StackPanel>
                </Grid>
              </DataTemplate>
            </ListBox.ItemTemplate>
          </ListBox>
          <Button x:Name="AddGroupButton" Grid.Row="2" Margin="0,12,0,0" HorizontalAlignment="Stretch" Click="OnAddGroupClick" />
        </Grid>
      </Border>

      <TabControl x:Name="MainTabs" Grid.Column="1" Margin="18">
        <TabItem x:Name="VersionsTab">
          <Grid ColumnDefinitions="210,*" Margin="0,12,0,0">
            <Grid RowDefinitions="*,Auto">
              <ListBox x:Name="VersionList" SelectionChanged="OnVersionSelectionChanged">
                <ListBox.ItemTemplate>
                  <DataTemplate>
                    <Grid Width="172" Height="30" ColumnDefinitions="*,Auto" Margin="2,0">
                      <TextBlock Text="{Binding Name}" VerticalAlignment="Center" />
                      <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="4" IsVisible="{Binding $parent[ListBoxItem].IsPointerOver}">
                        <Button Classes="icon-action" CommandParameter="{Binding Name}" ToolTip.Tip="{Binding EditText}" Click="OnEditVersionItemClick">
                          <PathIcon Data="{StaticResource EditIconGeometry}" />
                        </Button>
                        <Button Classes="icon-action" CommandParameter="{Binding Name}" ToolTip.Tip="{Binding DeleteText}" Click="OnDeleteVersionItemClick">
                          <PathIcon Data="{StaticResource DeleteIconGeometry}" />
                        </Button>
                      </StackPanel>
                    </Grid>
                  </DataTemplate>
                </ListBox.ItemTemplate>
              </ListBox>
              <Button x:Name="AddVersionButton" Grid.Row="1" Margin="0,12,12,0" HorizontalAlignment="Stretch" Click="OnAddVersionClick" />
            </Grid>

            <Grid x:Name="VersionEditor" Grid.Column="1" Margin="12,0,0,0" RowDefinitions="Auto,Auto,Auto,Auto,*,Auto,Auto">
              <TextBlock x:Name="ExecutableLabel" FontWeight="SemiBold" />
              <Grid Grid.Row="1" Margin="0,7,0,12" ColumnDefinitions="*,Auto">
                <TextBox x:Name="ExecutableTextBox" PlaceholderText="/path/to/executable" />
                <Button x:Name="BrowseExecutableButton" Grid.Column="1" Margin="8,0,0,0" Click="OnBrowseExecutableClick" />
              </Grid>
              <CheckBox x:Name="DefaultVersionCheckBox" Grid.Row="2" Click="OnDefaultVersionClick" />
              <StackPanel Grid.Row="3" Margin="0,18,0,8">
                <TextBlock x:Name="EnvironmentLabel" FontWeight="SemiBold" />
                <TextBlock x:Name="EnvironmentHintText" Margin="0,4,0,0" Opacity="0.65" TextWrapping="Wrap" />
              </StackPanel>
              <DataGrid x:Name="EnvironmentGrid" Grid.Row="4" AutoGenerateColumns="False" CanUserResizeColumns="True" />
              <StackPanel Grid.Row="5" Margin="0,10,0,0" Orientation="Horizontal" Spacing="8">
                <AutoCompleteBox x:Name="EnvironmentSuggestionBox" Width="270" FilterMode="Contains" />
                <Button x:Name="AddEnvironmentButton" Click="OnAddEnvironmentClick" />
                <Button x:Name="DeleteEnvironmentButton" Click="OnDeleteEnvironmentClick" />
              </StackPanel>
              <TextBlock x:Name="OverrideHintText" Grid.Row="6" Margin="0,8,0,0" Opacity="0.65" TextWrapping="Wrap" />
            </Grid>
          </Grid>
        </TabItem>

        <TabItem x:Name="ProjectsTab">
          <Grid Margin="0,12,0,0" RowDefinitions="*,Auto">
            <DataGrid x:Name="ProjectsGrid" AutoGenerateColumns="False" CanUserResizeColumns="True" />
            <StackPanel Grid.Row="1" Margin="0,10,0,0" Orientation="Horizontal" Spacing="8">
              <Button x:Name="AddProjectButton" Click="OnAddProjectClick" />
              <Button x:Name="DeleteProjectButton" Click="OnDeleteProjectClick" />
            </StackPanel>
          </Grid>
        </TabItem>
      </TabControl>
    </Grid>

    <Border Grid.Row="2" Padding="18,12" BorderBrush="{DynamicResource SemiColorBorder}" BorderThickness="0,1,0,0">
      <Grid ColumnDefinitions="*,Auto">
        <TextBlock x:Name="StatusText" VerticalAlignment="Center" />
        <Button x:Name="SaveButton" Grid.Column="1" MinWidth="100" Click="OnSaveClick" />
      </Grid>
    </Border>
  </Grid>
</Window>
